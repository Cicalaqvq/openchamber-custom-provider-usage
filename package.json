{
  "name": "openchamber-custom-provider-usage",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "description": "OpenChamber extension showing New API relay balances",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": { "openchamber": ">=2.5.0" },
    "contributes": {
      "panel": { "id": "custom-provider-usage", "name": "中转站余额", "icon": "wallet-line", "entry": "dist/extension/panel/index.html" },
      "statusSection": { "entry": "dist/extension/status/index.html", "title": "中转站余额", "height": 128 },
      "service": { "entry": "dist/extension/service/main.js", "runtime": "host" }
    }
  },
  "dependencies": {
    "@openchamber/sdk": "2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.25.5",
    "typescript": "5.8.3"
  }
}
